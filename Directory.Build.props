<!--
  Shared MSBuild settings for every project in the repository.
  Keep project files small: anything common belongs here.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML docs are reported by review, not by the compiler; documenting only the non-obvious
         parameters of a member is fine (CS1573). -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <Version>1.0.1</Version>
    <Product>Trasmuta</Product>
    <Authors>Pietro310</Authors>
    <Copyright>Copyright (c) 2026 Pietro310</Copyright>

    <!-- Where Trasmuta would be published. Nothing uses it while update checks are off (UpdateService.UpdatesEnabled). -->
    <FileeRepositoryUrl>https://github.com/Pietro310/Trasmuta</FileeRepositoryUrl>
    <RepositoryUrl>$(FileeRepositoryUrl)</RepositoryUrl>
  </PropertyGroup>
</Project>
